# Copy to apps/mobile/.env for local development.
# EXPO_PUBLIC_* values are compiled into the app and are PUBLIC. Never put a secret here.
# Preview and production builds get their values from EAS environment variables instead
# (eas env:create --environment preview --name EXPO_PUBLIC_API_URL --value https://...).

# development | preview | production
EXPO_PUBLIC_APP_VARIANT=development

# Where the dev build finds your local API (npm run dev:api):
#   iOS simulator:     http://localhost:3000
#   Android emulator:  http://10.0.2.2:3000
#   Physical device:   http://<your computer's LAN IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Local Supabase (`supabase start`, then `supabase status`): the Project URL and the Publishable key.
# The publishable key is safe to ship. NEVER put the secret key here: the app refuses to start with one.
#   iOS simulator:     http://127.0.0.1:54321
#   Android emulator:  http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- The cloud demo (ADR-0017, docs/release/demo-deployment.md) ---
# For `eas update`, put these in an EAS environment or a separate env file instead of the above:
#   EXPO_PUBLIC_APP_VARIANT=preview
#   EXPO_PUBLIC_API_URL=https://calm-guardian-api-<project number>.europe-west2.run.app
#   EXPO_PUBLIC_SUPABASE_URL=https://<project ref>.supabase.co
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<the hosted project's publishable key>
#   EAS_PROJECT_ID=<from eas init>
