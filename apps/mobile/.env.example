# Copy to apps/mobile/.env for local development.
# EXPO_PUBLIC_* values are compiled into the app and are PUBLIC. Never put a secret here.
# Preview and production builds get their values from EAS environment variables instead
# (eas env:create --environment preview --name EXPO_PUBLIC_API_URL --value https://...).

# development | preview | production
EXPO_PUBLIC_APP_VARIANT=development

# Where the dev build finds your local API (npm run dev:api):
#   iOS simulator:     http://localhost:3000
#   Android emulator:  http://10.0.2.2:3000
#   Physical device:   http://<your computer's LAN IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
