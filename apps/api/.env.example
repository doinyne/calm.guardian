# Copy to apps/api/.env for local development. Never commit real values.

# Port the API listens on. Cloud Run sets this to 8080 itself.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# Supabase. For local development, run `supabase start`, then `supabase status -o env` and copy
# API_URL and SECRET_KEY here. Remote values come from Secret Manager, never from a committed file.
SUPABASE_URL=http://127.0.0.1:54321
# Server-only admin key: it can delete any user. Never put it in the app or in an EXPO_PUBLIC_ value.
SUPABASE_SECRET_KEY=

# Postgres, for the API's own queries (ADR-0012). Local Supabase: `supabase status` → Database URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Keys that encrypt connected accounts' OAuth tokens at rest: comma-separated "<name>:<base64 32-byte
# key>" entries, newest first. Make one with: echo "k1:$(openssl rand -base64 32)"
# Every environment has its own; remote ones live in Secret Manager. Never commit a real key.
TOKEN_ENCRYPTION_KEYS=

# Bluesky sign-in (ADR-0003). While we use Bluesky's development client, the redirect must be
# http://127.0.0.1:<API port>/connections/bluesky/callback. Deployed APIs need a confidential client (M0b).
BLUESKY_REDIRECT_URL=http://127.0.0.1:3000/connections/bluesky/callback
# Where the API sends people back into the app after Bluesky: the app's own link scheme.
APP_CONNECT_RETURN_URL=calmguardian-dev://connect/bluesky
