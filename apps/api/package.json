{
  "name": "@calm-guardian/api",
  "version": "0.0.0",
  "private": true,
  "description": "Calm Guardian HTTP API.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts | pino-pretty --messageKey message",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --sourcemap --outfile=dist/server.cjs",
    "start": "node --enable-source-maps dist/server.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@calm-guardian/shared": "*",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.118.0",
    "hono": "^4.13.16",
    "jose": "^6.2.15",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
