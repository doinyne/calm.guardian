{
  "name": "calm-guardian",
  "version": "0.0.0",
  "private": true,
  "description": "Hide and restore social media posts during a mental health episode.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doinyne/calm.guardian.git"
  },
  "engines": {
    "node": ">=24.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @calm-guardian/api",
    "dev:mobile": "npm run start -w @calm-guardian/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.0.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
